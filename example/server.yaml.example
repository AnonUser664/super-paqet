# Linux server: use a local address assigned to the selected interface.
# All clients for this listener use the same key. An instance can also have
# peers and forwards alongside its listeners.
listeners:
  - address: 192.0.2.20:29999
    key_env: PAQET_PRIMARY_KEY

metrics: 127.0.0.1:9090

# Optional overrides when route/neighbor discovery is insufficient:
# listeners:
#   - address: 192.0.2.20:29999
#     key_env: PAQET_PRIMARY_KEY
#     packet_workers: 4
#     network:
#       interface: eth0
#       ipv4:
#         addr: 192.0.2.20:29999
#         router_mac: aa:bb:cc:dd:ee:ff
#       tcp:
#         local_flag: [PA]

# firewall: false # Only when external automation already provides the rules.
# profiling: true # Adds CPU profiling endpoints to the loopback metrics server.
