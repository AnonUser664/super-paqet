# Linux client: one process may forward through several named peers.
# Generate a key with `super-paqet secret`; provide matching keys at each end.
peers:
  primary:
    address: 203.0.113.10:29999
    key_env: PAQET_PRIMARY_KEY
  secondary:
    address: 203.0.113.20:29999
    key_env: PAQET_SECONDARY_KEY

forwards:
  - listen: 127.0.0.1:8080
    peer: primary
    target: 127.0.0.1:80
  - listen: 127.0.0.1:8443
    peer: secondary
    target: 127.0.0.1:443
  - listen: 127.0.0.1:5353
    peer: primary
    target: 1.1.1.1:53
    protocol: udp

metrics: 127.0.0.1:9090

# Most deployments need no tuning. Override discovery when necessary:
# peers:
#   primary:
#     address: 203.0.113.10:29999
#     key_env: PAQET_PRIMARY_KEY
#     sessions: 8
#     network:
#       interface: eth0
#       ipv4:
#         addr: 192.0.2.10:0
#         router_mac: aa:bb:cc:dd:ee:ff
#       tcp:
#         local_flag: [PA]
#         remote_flag: [PA]
#     kcp:
#       mtu: 1350
#       sndwnd: 32768       # adaptive send-window ceiling, segments
#       rcvwnd: 32768       # receive-window ceiling, segments
#       streambuf: 16777216 # adaptive per-stream window ceiling, bytes
#       smuxbuf: 33554432   # aggregate per-session receive budget, bytes
#       block: aes-128-gcm
#       dshard: 0
#       pshard: 0

# limits:
#   connections: 200000
#   sessions: 1024
#   memory_mib: 1024        # soft Go memory limit, excludes kernel socket memory
#   open_timeout: 10s
#   dial_timeout: 5s
#   udp_idle: 60s
